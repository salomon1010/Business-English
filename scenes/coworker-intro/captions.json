{"vid":"scene.coworker-intro","source":"scene: OpenAI TTS voices, word times measured by Whisper","lang":"en","measured":true,"duration":60.868,"cues":[{"t":0.4,"txt":"Hi, I'm Daniel. I work with the data team.","spk":"daniel"},{"t":5.516,"txt":"Nice to meet you, Daniel. I'm Maya. I just joined as a project coordinator.","spk":"maya"},{"t":11.232,"txt":"Welcome to the team! What does your new role involve?","spk":"daniel"},{"t":16.444,"txt":"I'm responsible for planning our projects and keeping everyone on schedule.","spk":"maya"},{"t":22.304,"txt":"That sounds like a busy job. We'll probably work together on the monthly reports.","spk":"daniel"},{"t":29.82,"txt":"Great. Could you tell me a bit more about what your team does?","spk":"maya"},{"t":36.376,"txt":"Sure. We collect the numbers, check them carefully, and turn them into clear reports for the managers.","spk":"daniel"},{"t":44.39,"txt":"That's really helpful, thank you. Who should I talk to if I have questions about the data?","spk":"maya"},{"t":50.952,"txt":"Just come to me. My desk is right over there, by the window.","spk":"daniel"},{"t":56.812,"txt":"Perfect. Let's grab a coffee later this week.","spk":"maya"}],"words":[{"t":0.4,"w":"Hi,"},{"t":1.46,"w":"I'm"},{"t":1.98,"w":"Daniel."},{"t":2.66,"w":"I"},{"t":3.18,"w":"work"},{"t":3.34,"w":"with"},{"t":3.52,"w":"the"},{"t":3.8,"w":"data"},{"t":3.92,"w":"team."},{"t":5.516,"w":"Nice"},{"t":5.896,"w":"to"},{"t":6.136,"w":"meet"},{"t":6.236,"w":"you,"},{"t":6.536,"w":"Daniel."},{"t":7.416,"w":"I'm"},{"t":7.616,"w":"Maya."},{"t":8.356,"w":"I"},{"t":8.556,"w":"just"},{"t":8.816,"w":"joined"},{"t":9.096,"w":"as"},{"t":9.256,"w":"a"},{"t":9.516,"w":"project"},{"t":9.716,"w":"coordinator."},{"t":11.232,"w":"Welcome"},{"t":11.812,"w":"to"},{"t":11.992,"w":"the"},{"t":12.172,"w":"team!"},{"t":13.392,"w":"What"},{"t":13.532,"w":"does"},{"t":13.832,"w":"your"},{"t":14.092,"w":"new"},{"t":14.412,"w":"role"},{"t":14.752,"w":"involve?"},{"t":16.444,"w":"I'm"},{"t":17.22
.DS_Store
.playwright-mcp/
# Translation-review packets (regenerate with the review script). Kept out of
# the repo because everything committed here is served publicly from
# app.lomonec.com — these are working files for reviewers, not site content.
review/

# Node dependencies for services/ (assessor API and UI). Never served publicly.
node_modules/

# Secrets must never land here. EVERYTHING committed to this repo is served
# publicly from app.lomonec.com — backend/events/query.sh is downloadable right
# now — so a committed token is not merely leaked, it is published and fetchable
# over HTTP. The real token lives OUTSIDE the repo, in
# ~/.config/be-mastery/events.env (see `./backend/events/query.sh login`).
# These patterns are the second line of defence, for the day someone creates a
# .env here out of habit and runs `git add -A`.
.env
.env.*
!.env.example
*.pem
*.key
# Sign in with Apple and Firebase admin key material (Oct 2026). These were
# ignored only under mobile/ios/, so a .p8 downloaded to the repository root
# — or a key.json left in backend/mail/ after `wrangler secret put` — was one
# `git add -A` away from being published at app.lomonec.com. The root is worse
# than most places: mobile/ios/scripts/sync-web.mjs copies the whole root into
# the iOS bundle, so such a file would ship inside the App Store binary too.
# Apple's .p8 belongs in the Firebase console and the service-account JSON in
# `wrangler secret put FB_SA_JSON` — keep both outside the repository.
*.p8
AuthKey_*
*-firebase-adminsdk-*.json

# The promotion playbook. Kept out because everything committed here is served
# publicly, and it contains posts written in the first person for you to send as
# yourself — a scripted "I built this" post reads badly if someone can find the
# script at app.lomonec.com. It is a working file, like review/. Back it up
# outside the repo if you want it on another machine.
marketing/PROMO-PLAYBOOK.md

# Generated promo videos — 30 MB of MP4 that would otherwise be served from
# app.lomonec.com and bloat every clone. Reproducible any time with
# scripts/promo-video/record.mjs, which IS committed.
marketing/video/

# The generated analytics dashboard. Same reason: committing it would publish
# your own product numbers — opens, funnel, countries — at
# app.lomonec.com/backend/events/dashboard.html for anyone to read. It is a
# build artefact; regenerate it with `./backend/events/query.sh dashboard`.
backend/events/dashboard.html
marketing/build/

# python bytecode
__pycache__/
*.pyc
marketing/partnership/assets/deck-preview/slide-*.png
marketing/partnership/assets/deck-preview-value/slide-*.png
tests/node_modules/

# Local wrangler state (dev D1 sqlite, logs) — never source, never served
.wrangler/
tests/node_modules

# local Worker secrets for tests (a throwaway VAPID key) — never commit
backend/push/.dev.vars

backend/mail/.dev.vars
scripts/welding-photos/out/

# the assembled portal site (scripts/portal/build-site.mjs) — a build artefact
_site/

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/be_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/be_widget_bg_dark">

    <!-- header: mark, programme, streak chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/be_mark"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="BE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:background="@drawable/be_widget_mark_ge" />
        <TextView
            android:id="@+id/be_programme"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/be_streak_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="11sp"
            android:fontFamily="sans-serif-black"
            android:singleLine="true"
            android:background="@drawable/be_widget_card_dark" />
    </LinearLayout>

    <!-- today -->
    <LinearLayout
        android:id="@+id/be_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/be_widget_card_dark">
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">
            <ImageView
                android:id="@+id/be_ring"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/be_streak_n"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal|bottom"
                android:paddingBottom="11dp"
                android:textSize="21sp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="0" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/be_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/be_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/be_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/be_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:ellipsize="end"
                android:background="@drawable/be_widget_pill_ge" />
        </LinearLayout>
    </LinearLayout>

    <!-- road map -->
    <LinearLayout
        android:id="@+id/be_road"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/be_road_h"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true" />
            <TextView
                android:id="@+id/be_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true" />
        </LinearLayout>
        <ImageView
            android:id="@+id/be_strip"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />
        <ImageView
            android:id="@+id/be_phases"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- three facts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/be_stat1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/be_widget_card_dark">
            <TextView android:id="@+id/be_stat1_v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="sans-serif-black" android:singleLine="true" />
            <TextView android:id="@+id/be_stat1_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/be_stat2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/be_widget_card_dark">
            <TextView android:id="@+id/be_stat2_v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="sans-serif-black" android:singleLine="true" />
            <TextView android:id="@+id/be_stat2_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/be_stat3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/be_widget_card_dark">
            <TextView android:id="@+id/be_stat3_v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="sans-serif-black" android:singleLine="true" />
            <TextView android:id="@+id/be_stat3_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/be_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>

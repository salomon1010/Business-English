<?xml version="1.0" encoding="utf-8"?>
<!-- The Welding Mastery widget (owner, 9 Oct 2026): words mastered of 250,
     level, XP, streak and today's shift. Welding English only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/be_widget_wm_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="AZ"
            android:textColor="#FFD36B"
            android:textSize="9sp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:background="@drawable/be_widget_wm_mark" />
        <TextView
            android:id="@+id/wm_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/be_widget_name_mastery"
            android:textColor="#FFD36B"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="bottom">
        <TextView
            android:id="@+id/wm_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/wm_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:textColor="#9AA8C4"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/wm_mastered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#34D399"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true" />

    <TextView
        android:id="@+id/wm_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#DBE3F4"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/wm_shift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#DBE3F4"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:ellipsize="end" />

    <ProgressBar
        android:id="@+id/wm_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@drawable/be_widget_wm_bar" />

    <ProgressBar
        android:id="@+id/wm_bar_ok"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="100"
        android:visibility="gone"
        android:progressDrawable="@drawable/be_widget_wm_bar_ok" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- today's shift: a thin rounded bar, electric blue on a faint track -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><solid android:color="#17FFFFFF" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><solid android:color="#3B82F6" /><corners android:radius="3dp" /></shape></clip>
    </item>
</layer-list>

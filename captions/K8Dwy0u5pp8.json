,"w":"example,"},{"t":58.36,"w":"in"},{"t":58.36,"w":"Berlin,"},{"t":58.36,"w":"85%"},{"t":58.36,"w":"of"},{"t":58.36,"w":"the"},{"t":58.36,"w":"Sun"},{"t":58.36,"w":"will"},{"t":58.36,"w":"be"},{"t":58.36,"w":"covered."},{"t":62.32,"w":"92%"},{"t":62.32,"w":"in"},{"t":62.32,"w":"Paris"},{"t":62.32,"w":"and"},{"t":62.32,"w":"in"},{"t":62.32,"w":"London"},{"t":62.32,"w":"90%."},{"t":65.96,"w":"It"},{"t":65.96,"w":"will"},{"t":65.96,"w":"be"},{"t":65.96,"w":"the"},{"t":65.96,"w":"first"},{"t":65.96,"w":"solar"},{"t":65.96,"w":"eclipse"},{"t":65.96,"w":"in"},{"t":65.96,"w":"Europe"},{"t":65.96,"w":"since"},{"t":65.96,"w":"1999."},{"t":70.28,"w":"Wow."},{"t":70.28,"w":"Becca,"},{"t":70.28,"w":"are"},{"t":70.28,"w":"you"},{"t":70.28,"w":"going"},{"t":70.28,"w":"to"},{"t":70.28,"w":"be"},{"t":70.28,"w":"watching"},{"t":70.28,"w":"the"},{"t":70.28,"w":"eclipse?"},{"t":73.32,"w":"I"},{"t":73.32,"w":"am,"},{"t":73.32,"w":"I'm"},{"t":73.32,"w":"really"},{"t":73.32,"w":"excited"},{"t":73.32,"w":"about"},{"t":73.32,"w":"it."},{"t":75.84,"w":"How"},{"t":75.84,"w":"about"},{"t":75.84,"w":"you,"},{"t":75.84,"w":"Georgie?"},{"t":77.08,"w":"Well,"},{"t":77.08,"w":"I"},{"t":77.08,"w":"only"},{"t":77.08,"w":"heard"},{"t":77.08,"w":"about"},{"t":77.08,"w":"it"},{"t":77.08,"w":"this"},{"t":77.08,"w":"week,"},{"t":77.08,"w":"so"},{"t":77.08,"w":"I"},{"t":77.08,"w":"don't"},{"t":77.08,"w":"feel"},{"t":77.08,"w":"very"},{"t":77.08,"w":"prepared,"},{"t":81.36,"w":"but"},{"t":81.36,"w":"I"},{"t":81.36,"w":"probably"},{"t":81.36,"w":"will"},{"t":81.36,"w":"try"},{"t":81.36,"w":"and"},{"t":81.36,"w":"watch"},{"t":81.36,"w":"it."},{"t":82.92,"w":"I"},{"t":82.92,"w":"just"},{"t":82.92,"w":"need"},{"t":82.92,"w":"to"},{"t":82.92,"w":"find"},{"t":82.92,"w":"a"},{"t":82.92,"w":"safe"},{"t":82.92,"w":"way"},{"t":82.92,"w":"to"},{"t":82.92,"w":"do"},{"t":82.92,"w":"it."},{"t":85.04,"w":"Yeah,"},{"t":85.04,"w":"we'll"},{"t":85.04,"w":"talk"},{"t":85.04,"w":"more"},{"t":85.04,"w":"about"},{"t":85.04,"w
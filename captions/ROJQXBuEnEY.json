{"vid":"ROJQXBuEnEY","source":"ROJQXBuEnEY.en.json3","lang":"en","cues":[{"t":1.3,"txt":"Industrial machinery works around the clock"},{"t":4.1,"txt":"to manufacture food products,"},{"t":6.1,"txt":"generate power,"},{"t":7.5,"txt":"and move suitcases at the airport."},{"t":9.9,"txt":"Industrial machinery maintenance workers,"},{"t":11.9,"txt":"mechanics, and millwrights"},{"t":13.5,"txt":"make sure industrial machinery"},{"t":15.2,"txt":"stays on the job."},{"t":17.3,"txt":"Machinery maintenance workers"},{"t":18.7,"txt":"do basic maintenance and repairs,"},{"t":20.7,"txt":"such as cleaning and lubricating machinery,"},{"t":23.2,"txt":"performing basic diagnostic tests,"},{"t":25.2,"txt":"and testing damaged parts."},{"t":27.7,"txt":"Using computerized diagnostic equipment"},{"t":30.1,"txt":"and expertise,"},{"t":31.8,"txt":"industrial machinery mechanics detect and fix"},{"t":34.3,"txt":"mechanical problems;"},{"t":35.9,"txt":"just listening to a machine’s vibration,"},{"t":38.4,"txt":"they can distinguish a worn belt"},{"t":40.2,"txt":"from a weak motor bearing."},{"t":42.4,"txt":"Millwrights install and disassemble"},{"t":44.7,"txt":"industrial machines"},{"t":46.2,"txt":"as well as conduct repairs."},{"t":48.1,"txt":"They often move machines within a facility,"},{"t":50.4,"txt":"carefully categorizing"},{"t":52.1,"txt":"and sequencing every part."},{"t":54.5,"txt":"They use cranes and forklifts"},{"t":56.3,"txt":"to bring the heavy parts to the new location."},{"t":59.1,"txt":"In addition to hand tools,"},{"t":60.9,"txt":"these workers use welding"},{"t":62.3,"txt":"and cutting equipment,"},{"t":63.7,"txt":"and precision-measuring devices."},{"t":66.1,"txt":"Because of the high risk of injury on the job,"},{"t":68.6,"txt":"safety precautions and protective equipment"},{"t":71,"txt":"such as hardhats, steel-toed shoes,"},{"t":73.9,"txt":"and earplugs are essential."},{"t":76.4,"txt":"Industrial machinery mechanics"},{"t":78.2,"txt":"and maintenance workers"},{"t":79.8,"txt":"typically work regular, full-time hours,"},{"t":82.2,"txt":"although overtime is common,"},{"t":84.2,"txt":"especially for mechanics."},{"t":86,"txt":"Millwrights may have more variable schedules"},{"t":88.8,"txt":"with downtime between projects,"},{"t":90.9,"txt":"as they usually work on a contract basis"},{"t":93.2,"txt":"to assemble or disassemble machines."},{"t":95.9,"txt":"While all 3 need a high school education"},{"t":98.7,"txt":"to enter the field,"},{"t":100.3,"txt":"machinery maintenance workers"},{"t":101.9,"txt":"typically receive on-the-job training;"},{"t":104.4,"txt":"industrial machinery mechanics"},{"t":106.2,"txt":"need a year or more of training;"},{"t":107.9,"txt":"and most millwrights learn their skills"},{"t":110.1,"txt":"in a 4-year apprenticeship—"},{"t":111.9,"txt":"although an associate’s degree"},{"t":113.5,"txt":"in industrial maintenance may suffice."}],"words":[{"t":1.266,"w":"Industrial"},{"t":1.266,"w":"machinery"},{"t":1.266,"w":"works"},{"t":1.266,"w":"around"},{"t":1.266,"w":"the"},{"t":1.266,"w":"clock"},{"t":4.1,"w":"to"},{"t":4.1,"w":"manufacture"},{"t":4.1,"w":"food"},{"t":4.1,"w":"products,"},{"t":6.1,"w":"generate"},{"t":6.1,"w":"power,"},{"t":7.5,"w":"and"},{"t":7.5,"w":"move"},{"t":7.5,"w":"suitcases"},{"t":7.5,"w":"at"},{"t":7.5,"w":"the"},{"t":7.5,"w":"airport."},{"t":9.933,"w":"Industrial"},{"t":9.933,"w":"machinery"},{"t":9.933,"w":"maintenance"},{"t":9.933,"w":"workers,"},{"t":11.866,"w":"mechanics,"},{"t":11.866,"w":"and"},{"t":11.866,"w":"millwrights"},{"t":13.5,"w":"make"},{"t":13.5,"w":"sure"},{"t":13.5,"w":"industrial"},{"t":13.5,"w":"machinery"},{"t":15.233,"w":"stays"},{"t":15.233,"w":"on"},{"t":15.233,"w":"the"},{"t":15.233,"w":"job."},{"t":17.3,"w":"Machinery"},{"t":17.3,"w":"maintenance"},{"t":17.3,"w":"workers"},{"t":18.7,"w":"do"},{"t":18.7,"w":"basic"},{"t":18.7,"w":"maintenance"},{"t":18.7,"w":"and"},{"t":18.7,"w":"repairs,"},{"t":20.666,"w":"such"},{"t":20.666,"w":"as"},{"t":20.666,"w":"cl
ts"},{"t":69.537,"w":"the"},{"t":69.537,"w":"signal"},{"t":69.537,"w":"produced"},{"t":69.537,"w":"by"},{"t":69.537,"w":"a"},{"t":69.537,"w":"temperature"},{"t":69.537,"w":"sensor"},{"t":72.73,"w":"into"},{"t":72.73,"w":"a"},{"t":72.73,"w":"standard"},{"t":72.73,"w":"instrumentation"},{"t":72.73,"w":"signal"},{"t":75.165,"w":"representing"},{"t":75.165,"w":"a"},{"t":75.165,"w":"process"},{"t":75.165,"w":"variable"},{"t":75.165,"w":"temperature"},{"t":75.165,"w":"being"},{"t":75.165,"w":"measured"},{"t":75.165,"w":"and"},{"t":75.165,"w":"controlled."},{"t":79.903,"w":"The"},{"t":79.903,"w":"most"},{"t":79.903,"w":"common"},{"t":79.903,"w":"transmitter"},{"t":79.903,"w":"instrumentation"},{"t":79.903,"w":"output"},{"t":79.903,"w":"signal"},{"t":79.903,"w":"is"},{"t":79.903,"w":"4"},{"t":79.903,"w":"to"},{"t":79.903,"w":"20"},{"t":79.903,"w":"mA."},{"t":86.765,"w":"The"},{"t":86.765,"w":"signal"},{"t":86.765,"w":"from"},{"t":86.765,"w":"the"},{"t":86.765,"w":"Temperature"},{"t":86.765,"w":"Transmitter"},{"t":86.765,"w":"is"},{"t":86.765,"w":"sent"},{"t":86.765,"w":"to"},{"t":86.765,"w":"a"},{"t":86.765,"w":"Controller"},{"t":90.901,"w":"that"},{"t":90.901,"w":"determines"},{"t":90.901,"w":"what"},{"t":90.901,"w":"action"},{"t":90.901,"w":"is"},{"t":90.901,"w":"required"},{"t":90.901,"w":"and"},{"t":90.901,"w":"generates"},{"t":90.901,"w":"an"},{"t":90.901,"w":"appropriate"},{"t":90.901,"w":"output"},{"t":90.901,"w":"signal."},{"t":96.316,"w":"Controllers"},{"t":96.316,"w":"are"},{"t":96.316,"w":"either"},{"t":96.316,"w":"a"},{"t":96.316,"w":"PLC"},{"t":96.316,"w":"or"},{"t":96.316,"w":"a"},{"t":96.316,"w":"DCS"},{"t":96.316,"w":"in"},{"t":96.316,"w":"process"},{"t":96.316,"w":"control"},{"t":96.316,"w":"today."},{"t":102.591,"w":"The"},{"t":102.591,"w":"Heating"},{"t":102.591,"w":"or"},{"t":102.591,"w":"Cooling"},{"t":102.591,"w":"source"},{"t":102.591,"w":"exerts"},{"t":102.591,"w":"a"},{"t":102.591,"w":"direct"},{"t":102.591,"w":"influence"},{"t":102.591,"w":"on"},{"
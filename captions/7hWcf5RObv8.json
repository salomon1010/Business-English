{"vid":"7hWcf5RObv8","source":"7hWcf5RObv8.en.json3","lang":"en","cues":[{"t":0,"txt":"O! say can you see by the dawn's early light,"},{"t":9.9,"txt":"What so proudly we hailed at the twilight's last gleaming,"},{"t":19.9,"txt":"Whose broad stripes and bright stars through the perilous fight,"},{"t":29.2,"txt":"O'er the ramparts we watched, were so gallantly streaming?"},{"t":38.8,"txt":"And the rockets' red glare, the bombs bursting in air,"},{"t":48.2,"txt":"Gave proof through the night that our flag was still there;"},{"t":58.1,"txt":"O! say does that star-spangled banner yet wave"},{"t":69.2,"txt":"O'er the land of the free and the home of the brave?"}],"words":[{"t":0,"w":"O!"},{"t":0,"w":"say"},{"t":0,"w":"can"},{"t":0,"w":"you"},{"t":0,"w":"see"},{"t":0,"w":"by"},{"t":0,"w":"the"},{"t":0,"w":"dawn's"},{"t":0,"w":"early"},{"t":0,"w":"light,"},{"t":9.9,"w":"What"},{"t":9.9,"w":"so"},{"t":9.9,"w":"proudly"},{"t":9.9,"w":"we"},{"t":9.9,"w":"hailed"},{"t":9.9,"w":"at"},{"t":9.9,"w":"the"},{"t":9.9,"w":"twilight's"},{"t":9.9,"w":"last"},{"t":9.9,"w":"gleaming,"},{"t":19.88,"w":"Whose"},{"t":19.88,"w":"broad"},{"t":19.88,"w":"stripes"},{"t":19.88,"w":"and"},{"t":19.88,"w":"bright"},{"t":19.88,"w":"stars"},{"t":19.88,"w":"through"},{"t":19.88,"w":"the"},{"t":19.88,"w":"perilous"},{"t":19.88,"w":"fight,"},{"t":29.16,"w":"O'er"},{"t":29.16,"w":"the"},{"t":29.16,"w":"ramparts"},{"t":29.16,"w":"we"},{"t":29.16,"w":"watched,"},{"t":29.16,"w":"were"},{"t":29.16,"w":"so"},{"t":29.16,"w":"gallantly"},{"t":29.16,"w":"streaming?"},{"t":38.76,"w":"And"},{"t":38.76,"w":"the"},{"t":38.76,"w":"rockets'"},{"t":38.76,"w":"red"},{"t":38.76,"w":"glare,"},{"t":38.76,"w":"the"},{"t":38.76,"w":"bombs"},{"t":38.76,"w":"bursting"},{"t":38.76,"w":"in"},{"t":38.76,"w":"air,"},{"t":48.22,"w":"Gave"},{"t":48.22,"w":"proof"},{"t":48.22,"w":"through"},{"t":48.22,"w":"the"},{"t":48.22,"w":"night"},{"t":48.22,"w":"that"},{"t":48.22,"w":"our"},{"t":48.22,"w":"flag"},{"t":48.22,"w":"was"},{"t":48.22
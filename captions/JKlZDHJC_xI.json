{"vid":"JKlZDHJC_xI","source":"JKlZDHJC_xI.en.json3","lang":"en","cues":[{"t":18.4,"txt":"I'm a poor wayfaring stranger While traveling through this world alone"},{"t":37.6,"txt":"There is no sickness, no toil, nor danger In that bright world to which I go"},{"t":57,"txt":"I'm going there to see my Father I'm going there no more to roam"},{"t":76,"txt":"I'm just going over Jordan I'm just going over home"},{"t":114.7,"txt":"I know dark clouds will gather 'round me I know my pathway is rough and steep"},{"t":133.8,"txt":"But golden fields lie out before me"},{"t":142.9,"txt":"Where weary eyes no more shall weep"},{"t":152.9,"txt":"I'm going there to see my Mother She said she'd meet me when I come"},{"t":171.8,"txt":"I'm just going over Jordan I'm just going over home"}],"words":[{"t":18.42,"w":"I'm"},{"t":18.42,"w":"a"},{"t":18.42,"w":"poor"},{"t":18.42,"w":"wayfaring"},{"t":18.42,"w":"stranger"},{"t":18.42,"w":"While"},{"t":18.42,"w":"traveling"},{"t":18.42,"w":"through"},{"t":18.42,"w":"this"},{"t":18.42,"w":"world"},{"t":18.42,"w":"alone"},{"t":37.64,"w":"There"},{"t":37.64,"w":"is"},{"t":37.64,"w":"no"},{"t":37.64,"w":"sickness,"},{"t":37.64,"w":"no"},{"t":37.64,"w":"toil,"},{"t":37.64,"w":"nor"},{"t":37.64,"w":"danger"},{"t":37.64,"w":"In"},{"t":37.64,"w":"that"},{"t":37.64,"w":"bright"},{"t":37.64,"w":"world"},{"t":37.64,"w":"to"},{"t":37.64,"w":"which"},{"t":37.64,"w":"I"},{"t":37.64,"w":"go"},{"t":56.98,"w":"I'm"},{"t":56.98,"w":"going"},{"t":56.98,"w":"there"},{"t":56.98,"w":"to"},{"t":56.98,"w":"see"},{"t":56.98,"w":"my"},{"t":56.98,"w":"Father"},{"t":56.98,"w":"I'm"},{"t":56.98,"w":"going"},{"t":56.98,"w":"there"},{"t":56.98,"w":"no"},{"t":56.98,"w":"more"},{"t":56.98,"w":"to"},{"t":56.98,"w":"roam"},{"t":75.96,"w":"I'm"},{"t":75.96,"w":"just"},{"t":75.96,"w":"going"},{"t":75.96,"w":"over"},{"t":75.96,"w":"Jordan"},{"t":75.96,"w":"I'm"},{"t":75.96,"w":"just"},{"t":75.96,"w":"going"},{"t":75.96,"w":"over"},{"t":75.96,"w":"home"},{"t":114.72,"w":"I"},{"t":1
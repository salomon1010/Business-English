{"vid":"8qj18Q4EhUQ","source":"8qj18Q4EhUQ.en.json3","lang":"en","cues":[{"t":1.3,"txt":"Safety on the job is no accident;"},{"t":4.2,"txt":"occupational health and safety specialists"},{"t":6.4,"txt":"and technicians keep workplaces"},{"t":8.2,"txt":"as accident-free as possible,"},{"t":10.5,"txt":"by looking for safer, healthier,"},{"t":12.3,"txt":"and more efficient work practices."},{"t":15,"txt":"Occupational health and safety specialists"},{"t":17,"txt":"inspect workplaces to ensure they meet safety"},{"t":20.1,"txt":"and environmental regulations."},{"t":22.3,"txt":"They examine factors such as lighting,"},{"t":24.2,"txt":"ventilation, and whether materials are stored"},{"t":26.6,"txt":"or disposed of correctly."},{"t":28.9,"txt":"Occupational health and safety technicians"},{"t":31,"txt":"work with specialists"},{"t":32.7,"txt":"to conduct tests and measure hazards."},{"t":35,"txt":"They may perform checks to make sure"},{"t":36.9,"txt":"workers are using required protective gear,"},{"t":39.6,"txt":"such as masks and hardhats."},{"t":42.2,"txt":"After a workplace accident or injury occurs,"},{"t":45,"txt":"occupational health and safety specialists"},{"t":47.1,"txt":"and technicians investigate potential causes"},{"t":50.3,"txt":"and plan how to prevent future events."},{"t":53.6,"txt":"They may develop training programs"},{"t":55.2,"txt":"to correct risky conditions,"},{"t":56.9,"txt":"and coordinate rehabilitation"},{"t":58.7,"txt":"for injured employees."},{"t":60.8,"txt":"Occupational health and safety specialists"},{"t":63.1,"txt":"and technicians generally work full time,"},{"t":65.8,"txt":"and travel from their offices or factories"},{"t":68.2,"txt":"to conduct fieldwork."},{"t":70.3,"txt":"They use gloves, respirators, and other gear"},{"t":73.1,"txt":"to minimize exposure to hazards."},{"t":75.7,"txt":"In emergencies,"},{"t":77,"txt":"they work weekends and irregular hours."},{"t":79.8,"txt":"Occupational health and safety specialists"},{"t":82.2,"txt":"typically need a bachelor’s degree"},{"t":83.9,"txt":"in occupational health and safety"},{"t":85.7,"txt":"or a related field,"},{"t":87.6,"txt":"while technicians typically enter the field"},{"t":89.9,"txt":"through on-the-job training,"},{"t":91.6,"txt":"or a related associate’s degree or certificate."}],"words":[{"t":1.333,"w":"Safety"},{"t":1.333,"w":"on"},{"t":1.333,"w":"the"},{"t":1.333,"w":"job"},{"t":1.333,"w":"is"},{"t":1.333,"w":"no"},{"t":1.333,"w":"accident;"},{"t":4.166,"w":"occupational"},{"t":4.166,"w":"health"},{"t":4.166,"w":"and"},{"t":4.166,"w":"safety"},{"t":4.166,"w":"specialists"},{"t":6.4,"w":"and"},{"t":6.4,"w":"technicians"},{"t":6.4,"w":"keep"},{"t":6.4,"w":"workplaces"},{"t":8.166,"w":"as"},{"t":8.166,"w":"accident-free"},{"t":8.166,"w":"as"},{"t":8.166,"w":"possible,"},{"t":10.466,"w":"by"},{"t":10.466,"w":"looking"},{"t":10.466,"w":"for"},{"t":10.466,"w":"safer,"},{"t":10.466,"w":"healthier,"},{"t":12.333,"w":"and"},{"t":12.333,"w":"more"},{"t":12.333,"w":"efficient"},{"t":12.333,"w":"work"},{"t":12.333,"w":"practices."},{"t":14.966,"w":"Occupational"},{"t":14.966,"w":"health"},{"t":14.966,"w":"and"},{"t":14.966,"w":"safety"},{"t":14.966,"w":"specialists"},{"t":17,"w":"inspect"},{"t":17,"w":"workplaces"},{"t":17,"w":"to"},{"t":17,"w":"ensure"},{"t":17,"w":"they"},{"t":17,"w":"meet"},{"t":17,"w":"safety"},{"t":20.133,"w":"and"},{"t":20.133,"w":"environmental"},{"t":20.133,"w":"regulations."},{"t":22.3,"w":"They"},{"t":22.3,"w":"examine"},{"t":22.3,"w":"factors"},{"t":22.3,"w":"such"},{"t":22.3,"w":"as"},{"t":22.3,"w":"lighting,"},{"t":24.2,"w":"ventilation,"},{"t":24.2,"w":"and"},{"t":24.2,"w":"whether"},{"t":24.2,"w":"materials"},{"t":24.2,"w":"are"},{"t":24.2,"w":"stored"},{"t":26.633,"w":"or"},{"t":26.633,"w":"disposed"},{"t":26.633,"w":"of"},{"t":26.633,"w":"correctly."},{"t":28.933,"w":"Occupational"},{"t":28.933,"w":"health"},{"t":28.933,"w":"and"},{"t":28.933,"w":"safety"},{"t":28.933,"w":"technicians"},{"t":31,"w":"work"},{"t
"w":"high-risk"},{"t":37.64,"w":"jobs,"},{"t":38.28,"w":"he"},{"t":38.44,"w":"mentally"},{"t":39,"w":"plans"},{"t":39.48,"w":"his"},{"t":39.64,"w":"entire"},{"t":40.28,"w":"day."},{"t":41.48,"w":"Now,"},{"t":42,"w":"it's"},{"t":42.28,"w":"6:30"},{"t":42.92,"w":"a.m."},{"t":43.96,"w":"The"},{"t":44.2,"w":"HSE"},{"t":44.72,"w":"officer"},{"t":45.2,"w":"leaves"},{"t":45.6,"w":"for"},{"t":45.72,"w":"the"},{"t":45.84,"w":"site"},{"t":46.36,"w":"carrying"},{"t":46.8,"w":"his"},{"t":47,"w":"safety"},{"t":47.4,"w":"helmet,"},{"t":47.92,"w":"safety"},{"t":48.36,"w":"shoes,"},{"t":49.04,"w":"reflective"},{"t":49.56,"w":"vest,"},{"t":50.12,"w":"and"},{"t":50.24,"w":"the"},{"t":50.32,"w":"necessary"},{"t":50.88,"w":"documents."},{"t":52.24,"w":"On"},{"t":52.4,"w":"the"},{"t":52.48,"w":"way,"},{"t":52.92,"w":"he"},{"t":53.08,"w":"keeps"},{"t":53.44,"w":"checking"},{"t":53.8,"w":"project"},{"t":54.32,"w":"updates"},{"t":54.8,"w":"and"},{"t":54.96,"w":"messages"},{"t":55.44,"w":"from"},{"t":55.6,"w":"the"},{"t":55.68,"w":"supervisors."},{"t":57.28,"w":"Now,"},{"t":57.8,"w":"it's"},{"t":58.08,"w":"7:00"},{"t":58.4,"w":"a.m."},{"t":59.36,"w":"The"},{"t":59.6,"w":"HSE"},{"t":60.16,"w":"officer"},{"t":60.6,"w":"has"},{"t":60.8,"w":"arrived"},{"t":61.28,"w":"at"},{"t":61.36,"w":"the"},{"t":61.44,"w":"site."},{"t":62.44,"w":"After"},{"t":62.76,"w":"completing"},{"t":63.2,"w":"the"},{"t":63.32,"w":"attendance,"},{"t":64,"w":"he"},{"t":64.16,"w":"immediately"},{"t":64.839,"w":"starts"},{"t":65.239,"w":"the"},{"t":65.32,"w":"site"},{"t":65.6,"w":"inspection."},{"t":66.76,"w":"The"},{"t":66.96,"w":"entry"},{"t":67.28,"w":"gate,"},{"t":67.76,"w":"emergency"},{"t":68.32,"w":"exits,"},{"t":68.96,"w":"fire"},{"t":69.28,"w":"extinguishers,"},{"t":70.04,"w":"and"},{"t":70.2,"w":"housekeeping"},{"t":70.8,"w":"are"},{"t":70.92,"w":"checked."},{"t":72.2,"w":"Now,"},{"t":72.68,"w":"it's"},{"t":73,"w":"7:30"},{"t":73.64,"w":"a.m."},{"t":74.6,"w":"Workers"},{"t":75.08,"w":"have"},{"t":75.24,"w":"gradua
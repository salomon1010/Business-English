,"w":"to"},{"t":29.36,"w":"conduct"},{"t":29.36,"w":"more"},{"t":29.36,"w":"interviews."},{"t":31.76,"w":"I"},{"t":31.76,"w":"think"},{"t":31.76,"w":"some"},{"t":31.76,"w":"companies"},{"t":31.76,"w":"probably"},{"t":31.76,"w":"are"},{"t":31.76,"w":"using"},{"t":31.76,"w":"it"},{"t":31.76,"w":"as"},{"t":31.76,"w":"a"},{"t":35.16,"w":"cost-saving"},{"t":35.16,"w":"measure"},{"t":35.16,"w":"if"},{"t":35.16,"w":"they"},{"t":35.16,"w":"do"},{"t":35.16,"w":"not"},{"t":35.16,"w":"have"},{"t":36.88,"w":"an"},{"t":36.88,"w":"in-house"},{"t":36.88,"w":"recruiter."},{"t":37.96,"w":"Employers"},{"t":37.96,"w":"are"},{"t":37.96,"w":"also"},{"t":37.96,"w":"facing"},{"t":37.96,"w":"a"},{"t":37.96,"w":"historic"},{"t":37.96,"w":"surge"},{"t":37.96,"w":"in"},{"t":37.96,"w":"job"},{"t":40.6,"w":"applications,"},{"t":40.6,"w":"with"},{"t":40.6,"w":"the"},{"t":40.6,"w":"number"},{"t":40.6,"w":"of"},{"t":40.6,"w":"U.S."},{"t":42.48,"w":"applicants"},{"t":42.48,"w":"for"},{"t":42.48,"w":"each"},{"t":42.48,"w":"open"},{"t":42.48,"w":"role"},{"t":42.48,"w":"doubling"},{"t":42.48,"w":"since"},{"t":42.48,"w":"the"},{"t":45.12,"w":"spring"},{"t":45.12,"w":"of"},{"t":45.12,"w":"2022,"},{"t":45.12,"w":"according"},{"t":45.12,"w":"to"},{"t":45.12,"w":"LinkedIn."},{"t":47.48,"w":"I"},{"t":47.48,"w":"think"},{"t":47.48,"w":"the"},{"t":47.48,"w":"biggest"},{"t":47.48,"w":"reason"},{"t":47.48,"w":"would"},{"t":47.48,"w":"be"},{"t":47.48,"w":"time"},{"t":47.48,"w":"saved."},{"t":50.32,"w":"One"},{"t":50.32,"w":"thing"},{"t":50.32,"w":"it's"},{"t":50.32,"w":"important"},{"t":50.32,"w":"to"},{"t":50.32,"w":"remember"},{"t":50.32,"w":"is"},{"t":50.32,"w":"that"},{"t":50.32,"w":"throughout"},{"t":53.6,"w":"the"},{"t":53.6,"w":"ups"},{"t":53.6,"w":"and"},{"t":53.6,"w":"downs"},{"t":53.6,"w":"of"},{"t":53.6,"w":"the"},{"t":53.6,"w":"economic"},{"t":53.6,"w":"and"},{"t":53.6,"w":"just"},{"t":53.6,"w":"sort"},{"t":53.6,"w":"of"},{"t":57.32,"w":"hiring"},{"t":57.32,"w":"climate"},{"t":57.32,"w":"over"},{"t":
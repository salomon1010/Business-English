"},{"t":53.24,"w":"dip"},{"t":53.24,"w":"her"},{"t":53.24,"w":"toes"},{"t":53.24,"w":"into"},{"t":53.24,"w":"it."},{"t":55,"w":"My"},{"t":55,"w":"rent"},{"t":55,"w":"is"},{"t":55,"w":"$96"},{"t":55,"w":"a"},{"t":55,"w":"month."},{"t":56.64,"w":"I"},{"t":56.64,"w":"have"},{"t":56.64,"w":"one"},{"t":56.64,"w":"roommate"},{"t":56.64,"w":"right"},{"t":56.64,"w":"now,"},{"t":58.16,"w":"and"},{"t":58.16,"w":"I"},{"t":58.16,"w":"do"},{"t":58.16,"w":"live"},{"t":58.16,"w":"in"},{"t":58.16,"w":"the"},{"t":58.16,"w":"biggest"},{"t":58.16,"w":"dorms"},{"t":58.16,"w":"that"},{"t":58.16,"w":"are"},{"t":58.16,"w":"available"},{"t":58.16,"w":"in"},{"t":61.52,"w":"Mammoth"},{"t":61.52,"w":"Village."},{"t":61.52,"w":"Coming"},{"t":61.52,"w":"to"},{"t":61.52,"w":"Yellowstone"},{"t":61.52,"w":"I"},{"t":61.52,"w":"did"},{"t":61.52,"w":"not"},{"t":61.52,"w":"have"},{"t":61.52,"w":"a"},{"t":69.82,"w":"car"},{"t":69.82,"w":"with"},{"t":69.82,"w":"me."},{"t":69.82,"w":"I"},{"t":69.82,"w":"do"},{"t":69.82,"w":"make"},{"t":69.82,"w":"use"},{"t":69.82,"w":"of"},{"t":69.82,"w":"the"},{"t":69.82,"w":"fact"},{"t":69.82,"w":"that"},{"t":69.82,"w":"being"},{"t":69.82,"w":"in"},{"t":69.82,"w":"a"},{"t":72.42,"w":"national"},{"t":72.42,"w":"park,"},{"t":72.42,"w":"I"},{"t":72.42,"w":"feel"},{"t":72.42,"w":"quite"},{"t":72.42,"w":"safe"},{"t":72.42,"w":"to"},{"t":74.02,"w":"hitchhike"},{"t":74.02,"w":"around."},{"t":75.26,"w":"This"},{"t":75.26,"w":"sign"},{"t":75.26,"w":"lives"},{"t":75.26,"w":"in"},{"t":75.26,"w":"my"},{"t":75.26,"w":"bag"},{"t":75.26,"w":"at"},{"t":75.26,"w":"all"},{"t":75.26,"w":"times."},{"t":77.38,"w":"It"},{"t":77.38,"w":"also"},{"t":77.38,"w":"says"},{"t":77.38,"w":"park"},{"t":77.38,"w":"employee"},{"t":77.38,"w":"so"},{"t":77.38,"w":"that"},{"t":77.38,"w":"you"},{"t":77.38,"w":"know"},{"t":77.38,"w":"I'm"},{"t":77.38,"w":"not"},{"t":79.78,"w":"dangerous."},{"t":79.78,"w":"Good"},{"t":79.78,"w":"old"},{"t":79.78,"w":"hitchhiker's"},{"t":79.78,"w":"thumb."},{"t":83.74,"w":"I"
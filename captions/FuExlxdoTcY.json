com"},{"t":36.4,"w":"So"},{"t":36.4,"w":"let's"},{"t":36.4,"w":"hear"},{"t":36.4,"w":"more"},{"t":36.4,"w":"about"},{"t":36.4,"w":"this"},{"t":36.4,"w":"story."},{"t":44.4,"w":"More"},{"t":44.4,"w":"than"},{"t":44.4,"w":"1000"},{"t":44.4,"w":"people"},{"t":44.4,"w":"have"},{"t":44.4,"w":"been"},{"t":44.4,"w":"confirmed"},{"t":44.4,"w":"dead"},{"t":47.28,"w":"after"},{"t":47.28,"w":"last"},{"t":47.28,"w":"week's"},{"t":47.28,"w":"flash"},{"t":47.28,"w":"floods"},{"t":47.28,"w":"on"},{"t":47.28,"w":"the"},{"t":47.28,"w":"border"},{"t":47.28,"w":"of"},{"t":47.28,"w":"Nepal"},{"t":47.28,"w":"and"},{"t":47.28,"w":"Tibet."},{"t":51.28,"w":"According"},{"t":51.28,"w":"to"},{"t":51.28,"w":"Nepal's"},{"t":51.28,"w":"disaster"},{"t":51.28,"w":"agency."},{"t":53.96,"w":"Almost"},{"t":53.96,"w":"4000"},{"t":53.96,"w":"people"},{"t":53.96,"w":"are"},{"t":53.96,"w":"still"},{"t":53.96,"w":"missing."},{"t":57.24,"w":"Rescuers"},{"t":57.24,"w":"are"},{"t":57.24,"w":"trying"},{"t":57.24,"w":"to"},{"t":57.24,"w":"reach"},{"t":57.24,"w":"hundreds"},{"t":57.24,"w":"of"},{"t":57.24,"w":"workers"},{"t":57.24,"w":"who've"},{"t":57.24,"w":"been"},{"t":57.24,"w":"trapped"},{"t":60.64,"w":"in"},{"t":60.64,"w":"a"},{"t":60.64,"w":"large"},{"t":60.64,"w":"network"},{"t":60.64,"w":"of"},{"t":60.64,"w":"tunnels"},{"t":60.64,"w":"at"},{"t":60.64,"w":"hydropower"},{"t":60.64,"w":"sites."},{"t":64.72,"w":"Nepalese"},{"t":64.72,"w":"Prime"},{"t":64.72,"w":"Minister"},{"t":64.72,"w":"Birendra"},{"t":64.72,"w":"Shah"},{"t":64.72,"w":"said"},{"t":64.72,"w":"on"},{"t":64.72,"w":"Monday"},{"t":67.84,"w":"that"},{"t":67.84,"w":"279"},{"t":67.84,"w":"people"},{"t":67.84,"w":"had"},{"t":67.84,"w":"been"},{"t":67.84,"w":"rescued"},{"t":67.84,"w":"from"},{"t":67.84,"w":"the"},{"t":67.84,"w":"sites."},{"t":72.04,"w":"A"},{"t":72.04,"w":"key"},{"t":72.04,"w":"cause"},{"t":72.04,"w":"of"},{"t":72.04,"w":"the"},{"t":72.04,"w":"deadly"},{"t":72.04,"w":"floods"},{"t":72.04,"w":"is"},{"t":72.04,"w":"thought"},{"t":7
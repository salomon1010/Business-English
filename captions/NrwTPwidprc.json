{"vid":"NrwTPwidprc","source":"NrwTPwidprc.en-orig.json3","lang":"en","cues":[{"t":2.2,"txt":"Soft foot, find and fix."},{"t":7.2,"txt":"Parallel soft foot."},{"t":9.6,"txt":"The feet are not coplanar. That is"},{"t":12.3,"txt":"rocking or parallel."},{"t":15.2,"txt":"The laser system shows high readings for"},{"t":17.8,"txt":"soft foot at opposite corners."},{"t":21,"txt":"Readings from the feeler gauge determine"},{"t":23.4,"txt":"which foot or feet to shim and how much."},{"t":28.1,"txt":"Why does this happen? One leg is too"},{"t":30.6,"txt":"short or two."},{"t":33,"txt":"The base plate or mounting pads are not"},{"t":35.7,"txt":"coplanar."},{"t":37.6,"txt":"Insufficient shims under one foot or"},{"t":40.3,"txt":"both diagonally opposed feet."},{"t":44.2,"txt":"How do you correct it?"},{"t":46.6,"txt":"If one foot is too short,"},{"t":49,"txt":"the feeler gauge shows that the short"},{"t":51.3,"txt":"foot has an even air gap and the"},{"t":53.5,"txt":"opposite air gap is tapered inward."},{"t":56.9,"txt":"Shim the amount of even air gap under"},{"t":59.7,"txt":"the short foot."},{"t":62,"txt":"If two feet are short,"},{"t":63.9,"txt":"the feeler gauges show tapered air gaps"},{"t":66.4,"txt":"that are bigger outwards on both feet."},{"t":69.5,"txt":"Shim both soft feet about 60% of the"},{"t":72.8,"txt":"feeler gauge values."},{"t":75.7,"txt":"Bent foot, outside angled foot."},{"t":78.6,"txt":"The bottom of the foot is not coplanar"},{"t":80.7,"txt":"with the base."},{"t":82.8,"txt":"The laser systems shows high soft foot"},{"t":85.5,"txt":"readings at three or four feet."},{"t":88.8,"txt":"The feeler gauge foot with the highest"},{"t":91,"txt":"soft foot reading will show a tapered"},{"t":93.3,"txt":"air gap from one corner of the foot to"},{"t":95.5,"txt":"another."},{"t":97.5,"txt":"Why does this happen? The machinery has"},{"t":100,"txt":"been dropped or otherwise roughly"},{"t":102.1,"txt":"handled."},{"t":103.6,"txt":"The base plates are bent or poorly"},{"t":105.8,"txt":"machined."},{"t":107.6,"txt":"There's a severe vertical angular"},{"t":109.6,"txt":"misalignment."},{"t":111.6,"txt":"The feet are welded."},{"t":114,"txt":"Foundation settling has occurred."},{"t":117.3,"txt":"How do you correct it?"},{"t":119,"txt":"Re-machine the feet, the base, or both."},{"t":123.5,"txt":"Build a step shim or a metal wedge."},{"t":127.8,"txt":"Safety note, trim the excess portion of"},{"t":130.8,"txt":"the step shims that protrude and"},{"t":132.8,"txt":"discard."},{"t":134.8,"txt":"Squishy soft foot."},{"t":136.8,"txt":"The laser system clearly and repeatedly"},{"t":139.6,"txt":"indicates soft foot."},{"t":142.1,"txt":"But the feeler gauges show little or no"},{"t":144.6,"txt":"gap."},{"t":146.3,"txt":"Why does this happen?"},{"t":147.9,"txt":"There's dirt, grease, paint, or rust"},{"t":151,"txt":"between the foot and the base."},{"t":153.8,"txt":"The shims are bent. The shims have burrs"},{"t":157.2,"txt":"or thread bite."},{"t":159.4,"txt":"There are too many shims. Don't use more"},{"t":161.8,"txt":"than three shims per foot."},{"t":164.6,"txt":"How do you correct it? Remove any"},{"t":166.8,"txt":"contamination under, around, and on top"},{"t":170.1,"txt":"of the foot."},{"t":171.9,"txt":"Replace bent or damaged shims. If you"},{"t":174.9,"txt":"follow the proper initial alignment"},{"t":177,"txt":"procedure, this type of soft foot should"},{"t":179.6,"txt":"not occur."},{"t":181.5,"txt":"Induced. The laser system shows more"},{"t":184.5,"txt":"than one soft foot."},{"t":186.9,"txt":"Usually on the same side or the same end"},{"t":189.2,"txt":"of the machine."},{"t":191.2,"txt":"The feeler gauge finds a gap, usually"},{"t":194,"txt":"parallel or nearly parallel."},{"t":197.2,"txt":"Why does this happen?"},{"t":199,"txt":"External forces are affecting the"},{"t":200.9,"txt":"machine frame, such as coupling or pipe"},{"t":204.2,"txt":"stress."},{"t":205.4,"txt":"Overhung machines, belts or chain loads"},{"t":208.6,"txt":"on pulleys and gears."},{"t":210.6,"txt":"The flex conduit is excessively rigid."},{"t":213.8,"txt":"Structural bracing is attached to the"},{"t":215.9,"txt":"machine."},{"t":217.2,"txt":"The jacking bolts are inadvertently left"},{"t":219.8,"txt":"tight."},{"t":221.6,"txt":"How do you correct it? Eliminate the"},{"t":223.5,"txt":"source of the external force."},{"t":226.1,"txt":"Use the laser alignment system for"},{"t":228.1,"txt":"tracking movement during pipe or"},{"t":230.1,"txt":"coupling installation."},{"t":232.5,"txt":"And always think of this."},{"t":235.1,"txt":"Remeasure and aim to have all soft foot"},{"t":238.3,"txt":"readings within 2 mils to minimize"},{"t":240.9,"txt":"machine frame distortion."},{"t":243.6,"txt":"Retighten all bolts to 100% torque."}],"words":[{"t":2.16,"w":"Soft"},{"t":2.76,"w":"foot,"},{"t":3.32,"w":"find"},{"t":3.76,"w":"and"},{"t":3.96,"w":"fix."},{"t":7.2,"w":"Parallel"},{"t":7.76,"w":"soft"},{"t":8.2,"w":"foot."},{"t":9.6,"w":"The"},{"t":9.72,"w":"feet"},{"t":10.28,"w":"are"},{"t":10.4,"w":"not"},{"t":10.8,"w":"coplanar."},{"t":11.72,"w":"That"},{"t":11.96,"w":"is"},{"t":12.28,"w":"rocking"},{"t":12.96,"w":"or"},{"t":13.28,"w":"parallel."},{"t":15.2,"w":"The"},{"t":15.32,"w":"laser"},{"t":15.68,"w":"system"},{"t":16.44,"w":"shows"},{"t":16.84,"w":"high"},{"t":17.08,"w":"readings"},{"t":17.6,"w":"for"},{"t":17.76,"w":"soft"},{"t":18.2,"w":"foot"},{"t":18.52,"w":"at"},{"t":18.68,"w":"opposite"},{"t":19.16,"w":"corners."},{"t":21,"w":"Readings"},{"t":21.52,"w":"from"},{"t":21.68,"w":"the"},{"t":21.8,"w":"feeler"},{"t":22.2,"w":"gauge"},{"t":22.88,"w":"determine"},{"t":23.4,"w":"which"},{"t":23.72,"w":"foot"},{"t":24.28,"w":"or"},{"t":24.52,"w":"feet"},{"t":25.24,"w":"to"},{"t":25.4,"w":"shim"},{"t":26.04,"w":"and"},{"t":26.16,"w":"how"},{"t":26.32,"w":"much."},{"t":28.08,"w":"Why"},{"t":28.28,"w":"does"},{"t":28.48,"w":"this"},{"t":28.68,"w":"happen?"},{"t":29.64,"w":"One"},{"t":30,"w":"leg"},{"t":30.24,"w":"is"},{"t":30.4,"w":"to
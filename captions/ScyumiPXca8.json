rs"},{"t":77.72,"w":"say."},{"t":78.96,"w":"However,"},{"t":78.96,"w":"the"},{"t":78.96,"w":"pig"},{"t":78.96,"w":"organ"},{"t":78.96,"w":"eventually"},{"t":78.96,"w":"failed"},{"t":78.96,"w":"and"},{"t":78.96,"w":"was"},{"t":78.96,"w":"removed,"},{"t":82.68,"w":"so"},{"t":82.68,"w":"Andrews"},{"t":82.68,"w":"needed"},{"t":82.68,"w":"some"},{"t":82.68,"w":"dialysis,"},{"t":82.68,"w":"a"},{"t":82.68,"w":"medical"},{"t":82.68,"w":"treatment"},{"t":85.44,"w":"where"},{"t":85.44,"w":"a"},{"t":85.44,"w":"machine"},{"t":85.44,"w":"functions"},{"t":85.44,"w":"like"},{"t":85.44,"w":"a"},{"t":85.44,"w":"kidney."},{"t":88.2,"w":"He"},{"t":88.2,"w":"then"},{"t":88.2,"w":"received"},{"t":88.2,"w":"a"},{"t":88.2,"w":"human"},{"t":88.2,"w":"kidney"},{"t":88.2,"w":"transplant"},{"t":88.2,"w":"82"},{"t":88.2,"w":"days"},{"t":88.2,"w":"later."},{"t":92.68,"w":"Let's"},{"t":92.68,"w":"have"},{"t":92.68,"w":"our"},{"t":92.68,"w":"first"},{"t":92.68,"w":"headline."},{"t":94.68,"w":"Pig"},{"t":94.68,"w":"kidneys"},{"t":94.68,"w":"successfully"},{"t":94.68,"w":"transplanted"},{"t":94.68,"w":"into"},{"t":94.68,"w":"humans."},{"t":98.36,"w":"And"},{"t":98.36,"w":"that's"},{"t":98.36,"w":"from"},{"t":98.36,"w":"the"},{"t":98.36,"w":"Financial"},{"t":98.36,"w":"Times,"},{"t":98.36,"w":"a"},{"t":98.36,"w":"British"},{"t":98.36,"w":"newspaper."},{"t":101.6,"w":"That"},{"t":101.6,"w":"headline"},{"t":101.6,"w":"again"},{"t":101.6,"w":"from"},{"t":101.6,"w":"the"},{"t":101.6,"w":"Financial"},{"t":101.6,"w":"Times."},{"t":104.24,"w":"Pig"},{"t":104.24,"w":"kidneys"},{"t":104.24,"w":"successfully"},{"t":104.24,"w":"transplanted"},{"t":104.24,"w":"into"},{"t":104.24,"w":"humans."},{"t":108,"w":"So,"},{"t":108,"w":"this"},{"t":108,"w":"headline"},{"t":108,"w":"talks"},{"t":108,"w":"about"},{"t":108,"w":"kidney"},{"t":108,"w":"transplants"},{"t":108,"w":"from"},{"t":108,"w":"pigs"},{"t":111.88,"w":"and"},{"t":111.88,"w":"we're"},{"t":111.88,"w":"going"},{"t":111.88,"w":"to"},{"t":111.88,"w":"look"},{
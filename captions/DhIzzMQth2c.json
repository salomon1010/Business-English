{"vid":"DhIzzMQth2c","source":"DhIzzMQth2c.en.json3","lang":"en","cues":[{"t":1.3,"txt":"Working in a harness"},{"t":2.6,"txt":"on top of a dam"},{"t":4,"txt":"hundreds of feet up…"},{"t":5.3,"txt":"crouched in a corner"},{"t":6.4,"txt":"of a storage tank…"},{"t":7.4,"txt":"sparks flying…"},{"t":8.8,"txt":"the work of a boilermaker takes strength,"},{"t":10.8,"txt":"stamina, and the willingness to endure"},{"t":13.1,"txt":"heights as well as confined spaces."},{"t":15.8,"txt":"Boilermakers install and repair boilers,"},{"t":18.4,"txt":"closed vats, and other large vessels"},{"t":20.7,"txt":"that are used to process"},{"t":22,"txt":"and store chemicals, oil, beer,"},{"t":23.8,"txt":"and hundreds of other products."},{"t":25.6,"txt":"Boilermakers also build and repair"},{"t":27.5,"txt":"blast furnaces, water treatment plants,"},{"t":29.8,"txt":"and pollution abatement equipment."},{"t":32,"txt":"Some install the huge pipes used in dams."},{"t":35,"txt":"Boilermakers follow blueprints"},{"t":36.9,"txt":"to install boilers,"},{"t":38.4,"txt":"and to test or repair them."},{"t":40.3,"txt":"They use flame-cutting torches"},{"t":41.8,"txt":"and welding equipment,"},{"t":43.1,"txt":"as well as other hand"},{"t":44.2,"txt":"and machine tools."},{"t":45.7,"txt":"Their work is physically demanding"},{"t":47.2,"txt":"and dangerous."},{"t":48.7,"txt":"They often work outdoors,"},{"t":50.2,"txt":"sometimes in extreme heat and cold."},{"t":52.5,"txt":"They must wear hardhats, safety glasses,"},{"t":54,"txt":"earplugs and other protective clothing…"},{"t":57.1,"txt":"including respirators"},{"t":58.6,"txt":"when working in enclosed spaces."},{"t":60.8,"txt":"Boilermakers work full time,"},{"t":62.7,"txt":"but may work overtime"},{"t":64.1,"txt":"to meet construction deadlines"},{"t":65.6,"txt":"or to complete work"},{"t":66.8,"txt":"during an equipment shutdown."},{"t":68.6,"txt":"They often travel to worksites…"},{"t":70.4,"txt":"living away from home for extended periods."},{"t":73.3,"txt":"Seasonal unemployment"},{"t":74.5,"txt":"is not unusual during summer and winter"},{"t":77.1,"txt":"—off seasons for maintenance—"},{"t":78.7,"txt":"or when construction projects"},{"t":80.2,"txt":"have been completed."},{"t":81.7,"txt":"After completing high school,"},{"t":83.1,"txt":"most boilermakers learn their trade"},{"t":84.7,"txt":"through apprenticeships."},{"t":86.4,"txt":"Welding experience is helpful"},{"t":88,"txt":"to qualify for an apprenticeship."}],"words":[{"t":1.333,"w":"Working"},{"t":1.333,"w":"in"},{"t":1.333,"w":"a"},{"t":1.333,"w":"harness"},{"t":2.566,"w":"on"},{"t":2.566,"w":"top"},{"t":2.566,"w":"of"},{"t":2.566,"w":"a"},{"t":2.566,"w":"dam"},{"t":4.033,"w":"hundreds"},{"t":4.033,"w":"of"},{"t":4.033,"w":"feet"},{"t":4.033,"w":"up…"},{"t":5.3,"w":"crouched"},{"t":5.3,"w":"in"},{"t":5.3,"w":"a"},{"t":5.3,"w":"corner"},{"t":6.366,"w":"of"},{"t":6.366,"w":"a"},{"t":6.366,"w":"storage"},{"t":6.366,"w":"tank…"},{"t":7.433,"w":"sparks"},{"t":7.433,"w":"flying…"},{"t":8.8,"w":"the"},{"t":8.8,"w":"work"},{"t":8.8,"w":"of"},{"t":8.8,"w":"a"},{"t":8.8,"w":"boilermaker"},{"t":8.8,"w":"takes"},{"t":8.8,"w":"strength,"},{"t":10.766,"w":"stamina,"},{"t":10.766,"w":"and"},{"t":10.766,"w":"the"},{"t":10.766,"w":"willingness"},{"t":10.766,"w":"to"},{"t":10.766,"w":"endure"},{"t":13.1,"w":"heights"},{"t":13.1,"w":"as"},{"t":13.1,"w":"well"},{"t":13.1,"w":"as"},{"t":13.1,"w":"confined"},{"t":13.1,"w":"spaces."},{"t":15.766,"w":"Boilermakers"},{"t":15.766,"w":"install"},{"t":15.766,"w":"and"},{"t":15.766,"w":"repair"},{"t":15.766,"w":"boilers,"},{"t":18.4,"w":"closed"},{"t":18.4,"w":"vats,"},{"t":18.4,"w":"and"},{"t":18.4,"w":"other"},{"t":18.4,"w":"large"},{"t":18.4,"w":"vessels"},{"t":20.7,"w":"that"},{"t":20.7,"w":"are"},{"t":20.7,"w":"used"},{"t":20.7,"w":"to"},{"t":20.7,"w":"process"},{"t":22,"w":"and"},{"t":22,"w":"store"},{"t":22,"w":"chemicals,"},{"t":22,"w":"oil,"},{"t":22,"w":"beer,"},{"t":23.833,"w":"and"},{"t":23.833,"w":"hundreds"},{"
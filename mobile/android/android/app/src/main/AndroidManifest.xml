<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- back from Sign in with Apple: the proxy at auth.lomonec.com hands Apple's answer here -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bemastery" android:host="apple" />
            </intent-filter>

        </activity>

        <!-- AdMob reads its app id from here (res/values/ads.xml). Real in every build, as
             Google recommends; only the ad UNITS are swapped for test units in debug/staging. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/be_ads_app_id" />

        <!-- notifications (BEPushPlugin + BEMessagingService): be-push sends data messages,
             the app draws them; the defaults below cover anything FCM ever draws itself -->
        <service
            android:name=".BEMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_be" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="be_daily" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NO advertising ID, as on iOS (npa=1, no IDFA): the Google Mobile Ads SDK adds AD_ID
         by itself; remove it so the app matches its Play declaration ("no advertising ID").
         Ads still load — non-personalised only, which is the rule anyway. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- and Android's Privacy Sandbox ad signals (ad id, topics, attribution) the same SDK adds -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <!-- the learner's own voice: every recorder (sessions, Shadow, Polish, Foundations, Partner).
         Capacitor's WebChromeClient turns the page's getUserMedia into the runtime prompt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Posture Coach (the same reason NSCameraUsageDescription gives on iOS) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+: the reminder / invitation prompt, asked from the Settings switch, never at launch -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>

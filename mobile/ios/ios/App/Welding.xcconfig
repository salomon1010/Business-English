// THE TWO-APP SPLIT (12 Oct 2026) — "BE Mastery — Welding English".
//
// One Xcode project builds both App Store apps. The project's own settings are
// the EXISTING app (com.lomonec.bemastery), untouched; this file is the only
// thing that makes a build the Welding one, and it is passed on the command
// line by mobile/ios/scripts/build.sh:
//
//   xcodebuild -xcconfig ios/App/Welding.xcconfig …
//
// Every target derives its bundle id from BE_APP_BUNDLE_ID, so the app and both
// extensions move together. The web bundle must be the Welding one too
// (npm run sync:welding); build.sh checks BUNDLE_INFO.txt before it calls
// xcodebuild, so the two halves can never be crossed.
//
// The version is set here rather than inherited: this is a NEW App Store app, so
// it starts at 1.0.0 (1) instead of carrying the existing app's numbers. Raise
// CURRENT_PROJECT_VERSION here for each Welding upload (scripts/bump-build.mjs
// bumps the project, which is the General English app).

BE_APP_BUNDLE_ID = com.lomonec.bemastery.welding
BE_APP_GROUP = group.com.lomonec.bemastery.welding
BE_DISPLAY_NAME = BE Welding
BE_PROGRAMME = welding
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 5

// Branding (13 Oct 2026). The project's own AppIcon and LaunchScreen are the
// EXISTING General English app's and are not touched; the Welding build selects
// its own through these two settings. Both asset sets are generated from
// branding/welding/logo-master.png by scripts/branding/make-welding-icons.py.
BE_APPICON_NAME = AppIconWelding
BE_LAUNCH_STORYBOARD = LaunchScreenWelding

// AdMob (31 Oct 2026). An AdMob app belongs to ONE store listing, so Welding must
// never send its ad requests under the General English app's ids (the project
// default). Welding has no AdMob app yet: the APP id is Google's sample one, only
// so the SDK has a well-formed value to load with, and the two UNITS are EMPTY, so
// BEAdsPlugin.configure answers "not_configured" in a store build and shows
// nothing (a debug / staging build swaps in Google's test units, as before).
// When the owner creates the Welding iOS app in AdMob, put its three ids here.
BE_ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
BE_ADMOB_INTERSTITIAL =
BE_ADMOB_NATIVE =

# Cache rules for lomonec.com (Workers static assets read this file).
# Every stylesheet and script is linked with ?v=… and the version is bumped on
# every change, so browsers may keep them for a year without asking again.
# Before this file every request said max-age=0: each page — and so each
# language switch — re-checked about 40 files, which is the lag phones felt.
# Pictures carry no version: a day, then refreshed quietly in the background.
# Never let two rules match one path (their Cache-Control values would merge).
# HTML keeps the default (always re-checked), so a deploy shows at once.

/bemastery/css/*
  Cache-Control: public, max-age=31536000, immutable

/bemastery/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/lomonec.css
  Cache-Control: public, max-age=31536000, immutable

/assets/lomonec.js
  Cache-Control: public, max-age=31536000, immutable

/bemastery/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/logo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/logo.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/logo-white.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
